{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node", "chrome"],
    "typeRoots": [
      "./node_modules/@types",
      "./apps/extension/node_modules/@types"
    ],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "apps/extension/*.config.ts"
  ]
}
