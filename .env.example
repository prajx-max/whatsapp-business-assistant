# Optional first-use backend configuration. Prefer /setup with Remember checked.
# Copy to .env (ignored by Git). Never add real keys to this example.
# Once .env.connections exists, its saved connections are authoritative.
# Never share or commit .env.connections; it contains backend credentials.
# The server always binds 127.0.0.1. The production extension expects port 3000.
API_PORT=3000
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
ASSISTANT_PROFILE_ID=sweet-crumbs-demo
